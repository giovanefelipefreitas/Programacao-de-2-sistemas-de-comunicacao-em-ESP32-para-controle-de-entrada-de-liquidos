//Servo motor
#include <WiFi.h>
#include <PubSubClient.h>
#include <ESP32Servo.h>         


const char* ssid = "Wokwi-GUEST";
const char* password = "";  // Nenhuma senha no Wokwi-GUEST
const char* mqttServer = "test.mosquitto.org";  // Endereço do servidor MQTT
const int mqttPort = 1883;
const char* mqttUser = "";  // Usuário MQTT (deixe vazio para o Wokwi)
const char* mqttPassword = "";  // Senha MQTT (deixe vazio para o Wokwi)


WiFiClient espClient;
PubSubClient client(espClient);


// Pino do servo-motor
const int servoPin = 13;
Servo servo;


void setup() {
  Serial.begin(115200);


  // Conectando-se à rede Wi-Fi
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Conectando ao WiFi...");
  }
  Serial.println("Conectado ao WiFi");


  // Configurando o cliente MQTT
  client.setServer(mqttServer, mqttPort);
  client.setCallback(callback);


  // Inicializando o servo
  servo.attach(servoPin);
}


void reconnect() {
  while (!client.connected()) {
    Serial.print("Tentando se conectar ao MQTT...");
    if (client.connect("ESP32_Controlador", mqttUser, mqttPassword)) {
      Serial.println("Conectado ao MQTT!");
      client.subscribe("leite/altura");  // Inscreve-se no tópico
    } else {
      Serial.print("Falha na conexão. Erro: ");
      Serial.print(client.state());
      delay(2000);
    }
  }
}


void callback(char* topic, byte* payload, unsigned int length) {
  // Recebe o valor da altura do leite
  String message = "";
  for (int i = 0; i < length; i++) {
    message += (char)payload[i];
  }


  // Converte a altura para um valor de ângulo do servo (0 a 180)
  long distancia = message.substring(10, message.length() - 2).toInt();  // Extraindo o valor numérico
  int angulo = map(distancia, 0, 200, 0, 180);  // Ajuste conforme necessário


  // Controla o servo-motor
  servo.write(angulo);


  Serial.print("Distancia: ");
  Serial.print(distancia);
  Serial.print(" cm, Servo em: ");
  Serial.println(angulo);
}


void loop() {
  // Garantir que a conexão MQTT seja mantida
  if (!client.connected()) {
    reconnect();
  }
  client.loop();
}


